# Supabase project (Settings -> API). Use the service_role key: it is only read by the server in /server.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_KEY=your-service-role-key
# Optional: overrides the URL derived from the project id
# SUPABASE_URL=https://your-project-id.supabase.co
API_PORT=3001
